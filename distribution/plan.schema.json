{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Joint distribution plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "distributionVersion",
    "web",
    "companion",
    "sharedUI",
    "protocol"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "distributionVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "web": {
      "$ref": "#/$defs/product"
    },
    "companion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "commit",
        "androidVersionCode"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "androidVersionCode": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2100000000
        }
      }
    },
    "sharedUI": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "const": 1
        },
        "maximum": {
          "const": 1
        }
      }
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "commit"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    }
  }
}
